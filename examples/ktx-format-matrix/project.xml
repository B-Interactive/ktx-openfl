<?xml version="1.0" encoding="utf-8"?>
<project>

	<meta title="KTX for OpenFL Format Matrix" package="org.ktx.openfl.format.matrix" version="1.0.0" />

	<app main="Main" file="KtxFormatMatrix" path="bin" />

	<window background="#888888" fps="60" />
	<window width="2560" height="1600" unless="mobile" />
	<window orientation="landscape" vsync="false" antialiasing="0" if="cpp" />
	<window resizable="true" />

	<source path="src" />

	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="starling" />
	<haxelib name="ktx-openfl" />

	<!-- PNG reference atlas -->
	<assets path="assets/img" include="*.png" type="image" />
	<assets path="assets/img" include="*.xml" type="text" />

	<!-- KTX atlases (ktx-openfl Starling bridge) -->
	<assets path="assets/ktx" include="*.ktx" type="binary" />
	<assets path="assets/ktx" include="*.xml" type="text" />

</project>
