package ktx.openfl;

import haxe.io.Bytes;
import openfl.errors.ArgumentError;
import openfl.errors.IllegalOperationError;
import ktx.openfl._internal.KtxGL;
import ktx.openfl._internal.KtxImage;
import openfl.utils.ByteArray;

/**
	Parses KTXv1 (Khronos Texture) files containing block-compressed 2D or
	cubemap textures.

	The constructor classifies the file from its 12-byte identifier before any
	parsing happens: KTXv2 data is recognised and rejected with an
	`IllegalOperationError`, and data that is not KTX fails with an
	`ArgumentError`. KTXv2 bytes are never interpreted as KTXv1.

	To read a texture:
	- create a `new Ktx1Reader()` instance from a ByteArray containing KTXv1 data
	- inspect the header fields (width, height, gpuFormat, and so on)
	- call `readTextures()` and provide an upload callback for each level and face

	The KTXv1 specification can be found here:
	<https://registry.khronos.org/KTX/specs/1.0/ktxspec.v1.html>
**/
class Ktx1Reader
{
	/**
		The width of the base level, in texels.
	**/
	public var width(default, null):Int;

	/**
		The height of the base level, in texels.
	**/
	public var height(default, null):Int;

	/**
		The number of cubemap faces (1 for 2D textures, 6 for cubemaps).
	**/
	public var faceCount(default, null):Int;

	/**
		The number of mipmap levels present in the file.
	**/
	public var mipCount(default, null):Int;

	/**
		True when the file stores only the base level and mipmap levels should be
		generated by the application or GPU.
	**/
	public var generateMipmaps(default, null):Bool;

	/**
		The OpenGL internal format stored in the file header.
	**/
	public var glInternalFormat(default, null):Int;

	/**
		The OpenGL base internal format stored in the file header.
	**/
	public var glBaseInternalFormat(default, null):Int;

	/**
		The GPU format bucket for this texture.
	**/
	public var gpuFormat(default, null):KtxGPUFormat;

	/**
		True when the texture format includes an alpha channel.
	**/
	public var hasAlpha(default, null):Bool;

	/**
		A friendly name for the texture format (for example, `DXT5`).
	**/
	public var formatName(default, null):String;

	/**
		True when the file stores a cubemap.
	**/
	public var isCubeMap(default, null):Bool;

	/**
		The parsed images, in level-then-face order.

		Advanced inspection only; use `readTextures()` to iterate over the images.
	**/
	@:noCompletion @:dox(hide) public var images(default, null):Array<KtxImage>;

	/**
		True when the file was written on a little-endian machine.
	**/
	public var littleEndian(default, null):Bool;

	/**
		Creates a KTXv1 reader that parses the header and image data from a ByteArray.

		The identifier at `byteArrayOffset` is classified before parsing begins:
		KTXv2 throws an `IllegalOperationError`, and data without a KTX signature
		throws an `ArgumentError`.

		@param data            The ByteArray containing KTXv1 texture data.
		@param byteArrayOffset The position in the ByteArray at which KTX data begins.
	**/
	public function new(data:ByteArray, byteArrayOffset:UInt = 0)
	{
		if (data == null)
		{
			throw new ArgumentError("KTX data must not be null");
		}

		if (isKtx2(data, byteArrayOffset))
		{
			throw new IllegalOperationError("KTX for OpenFL: KTXv2 is not supported yet");
		}

		if (!isKtx1(data, byteArrayOffset))
		{
			throw new ArgumentError("Data is not a KTX file");
		}

		// Std.int keeps the comparison in Int on Flash, where length is UInt.
		var length = Std.int(data.length);
		var offset = Std.int(byteArrayOffset);

		if (offset + KtxGL.KTX_HEADER_SIZE > length)
		{
			throw new ArgumentError("KTXv1 unexpected end of file reading header");
		}

		var position = offset + 12;

		// The endianness field is always decoded with a fixed byte order; the
		// resulting value tells the reader which order the rest of the file uses.
		var endianness = readU32(data, position, true);
		position += 4;

		littleEndian = (endianness == KtxGL.KTX_ENDIAN_REF);

		if (!littleEndian && endianness != KtxGL.KTX_ENDIAN_REF_REV)
		{
			throw new ArgumentError("KTXv1 unexpected endianness");
		}

		// glType, glTypeSize and glFormat must describe a block-compressed format.
		var glType = readHeaderField(data, position, length);
		var glTypeSize = readHeaderField(data, position += 4, length);
		var glFormat = readHeaderField(data, position += 4, length);
		position += 4;

		if (glType != 0 || glTypeSize != 1 || glFormat != 0)
		{
			throw new IllegalOperationError("KTXv1 uncompressed textures are not supported");
		}

		glInternalFormat = readHeaderField(data, position, length);
		glBaseInternalFormat = readHeaderField(data, position += 4, length);
		width = readHeaderField(data, position += 4, length);
		height = readHeaderField(data, position += 4, length);
		var depth = readHeaderField(data, position += 4, length);
		var arrayElements = readHeaderField(data, position += 4, length);
		faceCount = readHeaderField(data, position += 4, length);
		var levels = readHeaderField(data, position += 4, length);
		var keyValueDataBytes = readHeaderField(data, position += 4, length);
		position += 4;

		if (width == 0)
		{
			throw new ArgumentError("KTXv1 textures must have a width");
		}

		if (depth > 0 || arrayElements > 0)
		{
			throw new IllegalOperationError("KTXv1 only supports 2D and cubemap textures");
		}

		if (height == 0)
		{
			throw new IllegalOperationError("KTXv1 1D textures are not supported");
		}

		if (faceCount != 1 && faceCount != 6)
		{
			throw new ArgumentError("KTXv1 numberOfFaces must be either 1 or 6");
		}

		isCubeMap = (faceCount == 6);

		if (isCubeMap && width != height)
		{
			throw new ArgumentError("KTXv1 cubemap faces must be square");
		}

		// A level count of zero means the file contains only the base level and
		// the consumer should generate the rest of the mipmap chain.
		generateMipmaps = (levels == 0);
		mipCount = generateMipmaps ? 1 : levels;

		if (mipCount > 31)
		{
			throw new ArgumentError("KTXv1 contains an implausible number of mip levels");
		}

		var maxDimension = Std.int(Math.max(width, height));

		if (maxDimension < (1 << (mipCount - 1)))
		{
			throw new ArgumentError("KTXv1 contains more mip levels than its dimensions allow");
		}

		// Compared as `value > length - position` to avoid integer overflow on
		// hostile sizes near the maximum 32-bit value.
		if (keyValueDataBytes < 0 || keyValueDataBytes > length - position)
		{
			throw new ArgumentError("KTXv1 unexpected end of file reading key/value data");
		}

		position += keyValueDataBytes;

		var info = KtxFormat.describe(glInternalFormat);

		if (info == null)
		{
			throw new IllegalOperationError("KTX for OpenFL: unsupported GL internal format 0x"
				+ StringTools.hex(glInternalFormat, 8));
		}

		gpuFormat = info.gpuFormat;
		hasAlpha = info.hasAlpha;
		formatName = info.name;

		readImages(data, position, length);
	}

	/**
		Iterates over all mipmap levels and faces, calling the specified callback for
		each one.

		@param uploadCallback A function called for each mip level and face, with the parameters:
			@param face      The face index (0 for 2D textures, 0 to 5 for cubemaps).
			@param level     The mipmap level index.
			@param gpuFormat The GPU texture format enum value.
			@param width     The width of this mip level.
			@param height    The height of this mip level.
			@param dataLen   The length, in bytes, of the pixel data buffer.
			@param bytes     The pixel data for this mip level and face.
	**/
	public function readTextures(uploadCallback:UInt->Int->KtxGPUFormat->Int->Int->Int->Bytes->Void):Void
	{
		for (image in images)
		{
			uploadCallback(image.face, image.level, gpuFormat, image.width, image.height, image.size, image.bytes);
		}
	}

	/**
		Checks whether the provided ByteArray, at the specified offset, matches the
		KTXv1 file signature.

		@param data   The ByteArray to inspect.
		@param offset The position in the ByteArray to compare against the KTXv1 signature.
		@return       True if the signature matches what is expected for KTXv1, otherwise false.
	**/
	public static function isKtx1(data:ByteArray, offset:UInt = 0):Bool
	{
		return matchesSignature(data, offset, KtxGL.KTX1_SIGNATURE);
	}

	/**
		Checks whether the provided ByteArray, at the specified offset, matches the
		KTXv2 file signature.

		@param data   The ByteArray to inspect.
		@param offset The position in the ByteArray to compare against the KTXv2 signature.
		@return       True if the signature matches what is expected for KTXv2, otherwise false.
	**/
	public static function isKtx2(data:ByteArray, offset:UInt = 0):Bool
	{
		return matchesSignature(data, offset, KtxGL.KTX2_SIGNATURE);
	}

	/**
		Checks whether the provided ByteArray, at the specified offset, matches any
		supported KTX file signature (KTXv1 or KTXv2).

		@param data   The ByteArray to inspect.
		@param offset The position in the ByteArray to test.
		@return       True if the signature matches KTXv1 or KTXv2, otherwise false.
	**/
	public static function isKtx(data:ByteArray, offset:UInt = 0):Bool
	{
		return isKtx1(data, offset) || isKtx2(data, offset);
	}

	/**
		Compares the 12 bytes at `offset` against a KTX file identifier, with
		null and bounds guards so short buffers simply report false.
	**/
	private static function matchesSignature(data:ByteArray, offset:UInt, signature:Array<Int>):Bool
	{
		if (data == null) return false;

		// Std.int keeps the comparison in Int on Flash, where length is UInt.
		var length = Std.int(data.length);
		var start = Std.int(offset);

		if (start + 12 > length) return false;

		for (i in 0...12)
		{
			if (data[start + i] != signature[i]) return false;
		}

		return true;
	}

	/**
		Maps a KTXv1 OpenGL internal format value to the corresponding GPU format
		bucket, or null when the format is not supported.

		@param glInternalFormat The OpenGL internal format constant, for example
		0x83F0 for DXT1.
		@return                 The matching GPU format, or null.
	**/
	public static function gpuFormatFromGL(glInternalFormat:Int):Null<KtxGPUFormat>
	{
		var info = KtxFormat.describe(glInternalFormat);
		return (info != null) ? info.gpuFormat : null;
	}

	@:noCompletion private function readImages(data:ByteArray, position:Int, length:Int):Void
	{
		images = [];

		var levelWidth = width;
		var levelHeight = height;

		for (level in 0...mipCount)
		{
			if (position + 4 > length)
			{
				throw new ArgumentError("KTXv1 unexpected end of file reading imageSize");
			}

			var imageSize = readU32(data, position, littleEndian);
			position += 4;

			// Compared as `imageSize > length - position` to avoid integer
			// overflow on hostile sizes near the maximum 32-bit value.
			if (imageSize < 0 || imageSize > length - position)
			{
				throw new ArgumentError("KTXv1 unexpected end of file reading image data");
			}

			if (faceCount > 1 && imageSize % faceCount != 0)
			{
				throw new ArgumentError("KTXv1 cubemap image size is not divisible by the face count");
			}

			var faceSize = Std.int(imageSize / faceCount);

			for (face in 0...faceCount)
			{
				var imageBytes = Bytes.alloc(faceSize);
				var offset = position + face * faceSize;

				for (i in 0...faceSize)
				{
					imageBytes.set(i, data[offset + i]);
				}

				images.push(new KtxImage(level, face, levelWidth, levelHeight, faceSize, imageBytes));
			}

			// Advance past any padding to the next 4-byte boundary, per the KTX spec.
			position += imageSize + ((4 - (imageSize % 4)) % 4);

			// Next level dimensions (minimum 1).
			levelWidth = Std.int(Math.max(1, levelWidth >> 1));
			levelHeight = Std.int(Math.max(1, levelHeight >> 1));
		}
	}

	@:noCompletion private function readHeaderField(data:ByteArray, position:Int, length:Int):Int
	{
		if (position + 4 > length)
		{
			throw new ArgumentError("KTXv1 unexpected end of file reading header");
		}

		return readU32(data, position, littleEndian);
	}

	@:noCompletion private static inline function readU32(data:ByteArray, position:Int, littleEndian:Bool):Int
	{
		var b0 = data[position];
		var b1 = data[position + 1];
		var b2 = data[position + 2];
		var b3 = data[position + 3];

		if (littleEndian)
		{
			return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
		}

		return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
	}
}
